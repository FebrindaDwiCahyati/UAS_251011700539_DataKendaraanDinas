{
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "rewrites": [
    { "source": "/assets/(.*)", "destination": "/assets/$1" },
    { "source": "/upload/(.*)", "destination": "/upload/$1" },
    { "source": "/", "destination": "/api/index.php" },
    { "source": "/(.*)", "destination": "/api/$1" }
  ]
}